{
  "info": {
    "name": "用户管理接口",
    "description": "micro-user-service 用户 CRUD 接口测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "新增用户",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"zhangsan\",\n  \"password\": \"123456\",\n  \"email\": \"zhangsan@example.com\",\n  \"phone\": \"13800138000\",\n  \"status\": 1\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "根据ID查询用户",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/1"
      }
    },
    {
      "name": "修改用户",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"password\": \"654321\",\n  \"email\": \"zhangsan_new@example.com\",\n  \"phone\": \"13900139000\",\n  \"status\": 1\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "根据ID删除用户",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/users/1"
      }
    }
  ]
}
