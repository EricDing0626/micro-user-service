          }
        },
        {
          "name": "删除用户-不存在",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('业务码 404', function () { pm.expect(json.code).to.eql(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/99999"
          }
        },
        {
          "name": "批量删除-部分不存在",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('部分成功提示', function () {",
                  "  pm.expect(json.message).to.include('部分');",
                  "  pm.expect(json.data.failedCount).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [1, 99998, 99999]\n}"
            },
            "url": "{{baseUrl}}/api/users/batch"
          }
        },
        {
          "name": "批量删除-空列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('业务码 400', function () { pm.expect(json.code).to.eql(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
